# Copy to functions/.env and fill in your Razorpay keys (Dashboard -> Settings -> API Keys).
# PRODUCTION: store these in Cloud Secret Manager, not a plaintext .env shipped with the deploy.
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Required for the Razorpay webhook (/api/payment/webhook) to verify signatures.
# Set the same value in Razorpay Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: comma-separated list of allowed browser origins for CORS.
# Defaults to the project's Firebase Hosting domains + http://localhost:5173.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: hard global ceiling on Razorpay order creations per UTC day
# (abuse blast-radius cap). Defaults to 2000.
# ORDERS_DAILY_CAP=2000