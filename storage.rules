rules_version = '2';

// Firebase Storage security rules.
//
// Design goals:
//   - Deny by default; only the two known upload areas are writable.
//   - Avatars: a user may write ONLY their own (path keyed to their uid).
//   - Product images: admin-only writes (role looked up in Firestore).
//   - Uploads are constrained by size AND content-type; SVG is explicitly
//     rejected everywhere (embedded-script / stored-XSS vector).
//   - Reads are public for both (images are shown in the storefront), which
//     also means paths are effectively enumerable — that is acceptable ONLY
//     because writes are locked down, so nothing private can be planted here.
service firebase.storage {
  match /b/{bucket}/o {

    // Only real raster images we intend to serve. NOTE: image/svg+xml is
    // deliberately absent — SVGs can carry <script> and lead to stored XSS.
    function isSafeImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpe?g|webp|gif)');
    }

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User avatars: public read, owner-only write, ≤2 MB.
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpe?g|webp)');
    }

    // Product catalogue images: public read, admin-only write, ≤5 MB.
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}